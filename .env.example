# ==============================================================================
# JanSevaAI - Environment Configuration Template
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security Admin Token (Required for /api/admin/* crawl & compile tasks)
ADMIN_TOKEN=

# Database Configuration
DATABASE_PATH=Datasets/schemes.db

# LLM Providers Configuration
# Supported providers: "gemini" (direct Gemini API) or "openrouter" (OpenRouter API)
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Recommended for multimodal audio & structured JSON)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Configuration (Alternative / failover provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Text-to-Speech (TTS) Configuration
# Supported providers: "edge-tts" (zero-cost offline Python service) or "google-cloud"
TTS_PROVIDER=edge-tts
GOOGLE_TTS_API_KEY=

# Crawler & Ingestion Parameters
MYSCHEME_BASE_URL=https://www.myscheme.gov.in
CRAWL_CONCURRENCY=3
CRAWL_DELAY_SECONDS=0.35
CRAWL_LIMIT=200

# Frontend API URL (for Vite development)
VITE_API_URL=http://localhost:8000
